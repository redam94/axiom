__pycache__/
*.py[cod]
.venv/
.uv/
# uv.lock is COMMITTED, deliberately. It is what makes CI reproducible: without
# it every CI run re-resolved the dependency graph from scratch and could pick a
# pre-release nobody had ever run. See docs/notes/0043.
dist/
/build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store
docs/_build/
scratch/
.benchmarks/

# Files written by the report notebook when it executes.
nbs/report/readout.*

# Claude Code worktrees.
.claude/worktrees/

# Benchmark datasets whose licence this repository cannot satisfy by
# redistributing them. Fetched on request by `python benchmarks/fetch.py`,
# under the upstream terms. See benchmarks/README.md.
benchmarks/cache/

# Credentials. axiom-dossier reads GEMINI_API_KEY from here; it must never
# become a commit.
.env
.env.*
